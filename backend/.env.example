# --- Gemini AI ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api key
DATABASE_PATH=phishmind.db

# --- CORS (comma-separated frontend origins) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Live inbox scanning (optional) ---
# Fill in all three to let PhishMind watch this inbox automatically. Leave
# any of them blank to disable auto-scanning entirely (manual "Connect" from
# the dashboard still works either way).
#
# For Gmail: use an "App Password", not your normal password —
# Google Account -> Security -> 2-Step Verification -> App Passwords.
IMAP_HOST=imap.gmail.com
IMAP_USERNAME=
IMAP_APP_PASSWORD=

# Show a native Windows notification whenever a live-scanned email comes back
# SUSPICIOUS or PHISHING (works even if the dashboard isn't open). Set to
# "false" to disable.
DESKTOP_NOTIFICATIONS=true

# --- Email-activity watcher (Windows only) ---
# When true (default), PhishMind does NOT scan 24/7. Instead it watches for a
# visible window whose title matches one of EMAIL_WATCH_KEYWORDS (a Gmail/
# Outlook browser tab, the Outlook desktop app, etc.), starts scanning the
# moment one appears, and stops again once none have been seen for
# EMAIL_WATCH_GRACE_SECONDS — so it's only active while you're actually using
# email, and stops itself once you're done. Set to "false" for old-school
# always-on scanning from the moment the server boots.
EMAIL_WATCH_ENABLED=true
EMAIL_WATCH_KEYWORDS=gmail,outlook,mail
EMAIL_WATCH_POLL_SECONDS=5
EMAIL_WATCH_GRACE_SECONDS=30
